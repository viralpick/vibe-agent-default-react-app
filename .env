# API Configuration
VITE_API_BASE_URL_DEV=https://app-api-v2-dev.commerceos.ai
VITE_API_BASE_URL_STG=https://app-api-v2-stg.commerceos.ai
VITE_API_BASE_URL_PROD=https://app-api-v2.commerceos.ai

# Security Configuration
# Comma separated list of allowed origins
VITE_ALLOWED_ORIGINS=http://localhost:3000,https://app-dev.commerceos.ai,https://app.commerceos.ai,https://app-stg.commerceos.ai, https://os-dev.enhans.ai,http://ontology-dev.azure.lge.co.kr,http://app.atlas.lge.com,https://web.lghnh.enhans.ai

# 온프렘(폐쇄망) 콘솔 FE 관련 값. 기본값은 빈 문자열(SaaS 빌드 무영향).
# 온프렘 설치 시 agent-app 이 WEB_APPLICATION_FE_URL 로부터 파생해 sandbox env 로 주입한다.
# 하위호환: VITE_ALLOWED_ORIGINS(baked 목록)는 override 하지 않고, 아래 값을 추가로만 사용한다.
#   - VITE_WEB_APPLICATION_FE_ORIGIN      : postMessage 허용 origin. security.utils 가 baked 목록에 append.
#   - VITE_WEB_APPLICATION_FE_CONNECT_SRC : index.html CSP connect-src 의
#                                           %VITE_WEB_APPLICATION_FE_CONNECT_SRC% placeholder 를 채울 조각.
VITE_WEB_APPLICATION_FE_ORIGIN=
VITE_WEB_APPLICATION_FE_CONNECT_SRC=
