# API Configuration
VITE_API_BASE_URL_DEV=https://app-api-v2-dev.commerceos.ai
VITE_API_BASE_URL_STG=https://app-api-v2-stg.commerceos.ai
VITE_API_BASE_URL_PROD=https://app-api-v2.commerceos.ai

# Security Configuration
# Comma separated list of allowed origins
VITE_ALLOWED_ORIGINS=http://localhost:3000,https://app-dev.commerceos.ai,https://app.commerceos.ai,https://app-stg.commerceos.ai, https://os-dev.enhans.ai,http://ontology-dev.azure.lge.co.kr,http://app.atlas.lge.com,https://web.lghnh.enhans.ai

# 온프렘(폐쇄망) 콘솔 FE origin. 기본값은 빈 문자열(SaaS 빌드 무영향).
# 온프렘 설치 시 agent-app 이 WEB_APPLICATION_FE_URL 로부터 이 값을 sandbox env 로 주입한다:
#   - VITE_ALLOWED_ORIGINS      (postMessage exact origin) 를 override
#   - VITE_WEB_APPLICATION_FE_URL (아래) 를 CSP connect-src 조각으로 주입
# index.html CSP connect-src 의 %VITE_WEB_APPLICATION_FE_URL% placeholder 를 채운다.
VITE_WEB_APPLICATION_FE_URL=
